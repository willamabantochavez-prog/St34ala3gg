                    flake.Parent = parent
                    Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)

                    local fSt = Instance.new("UIStroke")
                    fSt.Color = flake.BackgroundColor3
                    fSt.Thickness = 1
                    fSt.Transparency = 0.3
                    fSt.Parent = flake

                    local fallDur = math.random(8, 18)
                    local drift = (math.random(-30, 30) / 100)
                    local endX = math.clamp(flake.Position.X.Scale + drift, 0.02, 0.98)

                    TS:Create(flake, TweenInfo.new(fallDur, Enum.EasingStyle.Linear), {
                        Position = UDim2.fromScale(endX, 1.05)
                    }):Play()

                    -- Sway horizontal
                    task.spawn(function()
                        local swayDur = math.random(2, 5)
                        while flake.Parent and flake.Position.Y.Scale < 1 do
                            TS:Create(flake, TweenInfo.new(swayDur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                                Position = UDim2.new(
                                    math.clamp(flake.Position.X.Scale + (math.random(-5, 5) / 100), 0.02, 0.98), 0,
                                    flake.Position.Y.Scale + 0.01, 0
                                ),
                                Rotation = math.random(-20, 20)
                            }):Play()
                            task.wait(swayDur)
                        end
                    end)

                    -- Fade out al final
                    task.wait(fallDur - 1)
                    if flake and flake.Parent then
                        TS:Create(flake, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundTransparency = 1
                        }):Play()
                        task.wait(1.1)
                        if flake and flake.Parent then flake:Destroy() end
                    end
                end
            end)
            task.wait(math.random(20, 60) / 100)
        end
    end

