                    flake.Size = UDim2.fromOffset(sz, sz)
                    flake.BackgroundColor3 = colors[math.random(1, #colors)]
                    flake.BackgroundTransparency = math.random(40, 75) / 100
                    flake.BorderSizePixel = 0
                    flake.ZIndex = 10
